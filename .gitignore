# ============================================
# .gitignore - Loại bỏ files không cần commit
# ============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo
*.pyd

# Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Credentials
.env
.env.local
.env.*.local

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
*.log.*

# Testing & Coverage
.pytest_cache/
.mypy_cache/
.hypothesis/
.coverage
htmlcov/
.tox/
*.cover
.cache/

# Build & Distribution
build/
dist/
*.egg-info/
*.egg
wheels/
*.whl

# Database Files - Runtime Data
# *.sqlite3
# *.db
# *.db-journal
# chromadb_data/
# chroma_db/

# Media & Uploads - Runtime Data
media/
uploads/
data/
static/uploads/

# Jupyter Notebooks
*.ipynb_checkpoints/
.ipynb_checkpoints/

# Docker
docker-compose.override.yml

# OS Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
*.bak
*~

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
